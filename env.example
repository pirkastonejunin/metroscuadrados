# Datos de tu app creada en https://partners.tiendanube.com
CLIENT_ID=
CLIENT_SECRET=

# Debe coincidir EXACTO con la "Redirect URL" configurada en el Partner Portal
# ej: https://mi-app.onrender.com/auth/callback
REDIRECT_URI=

# Se envia como header User-Agent en cada request a la API (requisito de Tiendanube)
# formato sugerido: "NombreDeTuApp (tu-email@dominio.com)"
USER_AGENT=CalculadoraM2PiedraNegra (tu-email@dominio.com)

# Namespace propio para no chocar con metafields de otras apps
METAFIELD_NAMESPACE=calculadora_m2
METAFIELD_KEY=unidades_por_bulto

# ID del script creado en el Partner Portal (pestaña Scripts > editar
# script > el numero que aparece en el titulo "Editar scripts #XXXX")
SCRIPT_ID=

# Cadena de conexion de tu cluster gratis de MongoDB Atlas
# (ver README, seccion "Base de datos persistente")
MONGODB_URI=

PORT=8000

# Lectura de facturas con IA (Compras y Gastos). Se usa el primero que tenga
# clave. Sin ninguna, el resto del sistema funciona igual y el botón de la IA
# avisa que no está configurada.
# Opción Google Gemini (aistudio.google.com > Get API key):
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.8-flash)
GEMINI_MODEL=
# Opción Anthropic (console.anthropic.com):
ANTHROPIC_API_KEY=
# Opcional: modelo de Anthropic (por defecto claude-sonnet-5-5)
FACTURA_IA_MODEL=
# Opcional: forzar "gemini" o "anthropic" si están cargadas las dos claves
FACTURA_IA_PROVEEDOR=

# --- Facturación electrónica ARCA (parte fiscal) ---
# Frase secreta para cifrar la clave privada del certificado en la base.
# Si no se define se usa MONGODB_URI como respaldo, pero conviene una propia:
# NO la cambies después de generar el certificado o habrá que generarlo de nuevo.
ARCA_SECRETO=
# Opcionales (solo para pruebas): reemplazan las URLs oficiales de ARCA.
# ARCA_WSAA_URL=
# ARCA_WSFE_URL=
# ARCA_PADRON_URL=
