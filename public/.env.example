# Datos de tu app creada en https://partners.tiendanube.com
CLIENT_ID=
CLIENT_SECRET=

# Debe coincidir EXACTO con la "Redirect URL" configurada en el Partner Portal
# ej: https://mi-app.onrender.com/auth/callback
REDIRECT_URI=

# Se envia como header User-Agent en cada request a la API (requisito de Tiendanube)
# formato sugerido: "NombreDeTuApp (tu-email@dominio.com)"
USER_AGENT=CalculadoraM2PiedraNegra (tu-email@dominio.com)

# Namespace propio para no chocar con metafields de otras apps
METAFIELD_NAMESPACE=calculadora_m2
METAFIELD_KEY=unidades_por_bulto

# ID del script creado en el Partner Portal (pestaña Scripts > editar
# script > el numero que aparece en el titulo "Editar scripts #XXXX")
SCRIPT_ID=

PORT=8000
